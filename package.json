{
  "name": "work4it",
  "version": "1.0.0",
  "private": true,
  "description": "Work4it - dansk browserbaseret træningsplanlægger og tracker",
  "scripts": {
    "test": "npm run test:dashboard && npm run test:ai-coach && npm run test:cloud-storage && npm run test:completion-analysis && npm run test:screenshot-import && npm run test:demo",
    "sync:assets": "node scripts/sync-official-assets.cjs",
    "prestart": "npm run sync:assets",
    "start": "node serve.cjs",
    "test:assets": "npm run sync:assets && node tests/official-assets.test.cjs",
    "test:ai-coach": "node tests/ai-coach.test.cjs",
    "test:subscriptions": "node tests/admin-subscription-test.test.cjs && node tests/pricing-consistency.test.cjs",
    "test:cloud-storage": "node tests/cloud-storage.test.cjs && node tests/profile-cloud-save.test.cjs",
    "test:dashboard": "node tests/dashboard-view-model.test.cjs && node tests/workout-heatmap.test.cjs && node tests/dashboard-ui.test.cjs && node tests/modern-dashboard-ui.test.cjs && node tests/workout-routing.test.cjs",
    "test:modern-ui": "node tests/modern-dashboard-ui.test.cjs",
    "test:heatmap": "node tests/workout-heatmap.test.cjs && node tests/dashboard-ui.test.cjs",
    "test:animations": "node tests/exercise-animations.test.cjs",
    "test:demo": "node tests/exercise-demo.test.cjs && node tests/exercise-animations.test.cjs",
    "test:completion-analysis": "node tests/completed-workout-analysis.test.cjs",
    "test:progression": "node tests/progression-service.test.cjs",
    "test:screenshot-import": "node tests/screenshot-import.test.cjs && node tests/screenshot-ocr-ai.test.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.184.0"
  }
}
